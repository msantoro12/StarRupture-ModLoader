<?xml version="1.0" encoding="utf-8"?>
<!--
  ImageDiskTests : a console test for the files the image library saves
  (UI/image_cache_file, image_cache_writer, image_disk): the file format and every
  way a file can be wrong, the folder key, the writer on a real temporary folder, and the
  saver on a fake readback.

  A manual test project, like the others under Tests: not part of the solution's
  build and not run by CI. Build the project file directly:

    msbuild Tests\ImageDiskTests\ImageDiskTests.vcxproj /p:Configuration="Client Release" /p:Platform=x64

  No GPU and no game are used. Output goes to build	ests\image_disk_tests.exe.
  The readback of the stored copy is checked on a real device by Tests\ImageShrinkHarness.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Client Debug|x64">
      <Configuration>Client Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Client Release|x64">
      <Configuration>Client Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{3B8D5E71-9C24-4F06-A1D3-6E72B4C95A18}</ProjectGuid>
    <RootNamespace>ImageDiskTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Set by Visual Studio and by building the .sln; empty when this project file is built on its own. -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Client Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Client Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <CoreDir>$(SolutionDir)StarRupture-ModLoader-Core\</CoreDir>
    <OutDir>$(SolutionDir)build\tests\</OutDir>
    <IntDir>$(SolutionDir)obj\Tests\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>image_disk_tests</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>_CONSOLE;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The live loader headers, on purpose: a test built against a stale copy would pass while testing nothing. -->
      <AdditionalIncludeDirectories>$(CoreDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Client Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Client Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Label="Test">
    <ClCompile Include="image_disk_tests.cpp" />
  </ItemGroup>
  <ItemGroup Label="Loader sources under test">
    <ClCompile Include="$(CoreDir)UI\image_cache_care.cpp" />
    <ClCompile Include="$(CoreDir)UI\image_cache_file.cpp" />
    <ClCompile Include="$(CoreDir)UI\image_cache_reader.cpp" />
    <ClCompile Include="$(CoreDir)UI\image_cache_writer.cpp" />
    <ClCompile Include="$(CoreDir)UI\image_disk.cpp" />
    <ClCompile Include="$(CoreDir)UI\image_library.cpp" />
    <ClCompile Include="$(CoreDir)UI\image_resample.cpp" />
    <ClInclude Include="$(CoreDir)UI\image_cache_care.h" />
    <ClInclude Include="$(CoreDir)UI\image_cache_file.h" />
    <ClInclude Include="$(CoreDir)UI\image_cache_reader.h" />
    <ClInclude Include="$(CoreDir)UI\image_cache_writer.h" />
    <ClInclude Include="$(CoreDir)UI\image_disk.h" />
    <ClInclude Include="$(CoreDir)UI\image_library.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
