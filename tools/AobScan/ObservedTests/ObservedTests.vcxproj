<?xml version="1.0" encoding="utf-8"?>
<!--
  ObservedTests : a console test for the locator sr-aobscan reports for a
  registry row (tools\AobScan\observed.cpp), against the loader's own
  VersionMap::ResolveLoaderEntry.

  A manual test project, like the others under Tests: not part of the
  solution's build and not run by CI. It needs the loader's version map
  (memory_scanner\version_map.cpp) and borrows Tests\VersionMapTests' test
  doubles, so build it in a tree that has both. Build the project file
  directly:

    msbuild tools\AobScan\ObservedTests\ObservedTests.vcxproj /p:Configuration="Client Release" /p:Platform=x64

  Output goes to build\tests\observed_tests.exe.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Client Release|x64">
      <Configuration>Client Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{3E7A5C12-84D9-4B6F-A1C0-52F8E3D9B746}</ProjectGuid>
    <RootNamespace>ObservedTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Set by Visual Studio and by building the .sln; empty when this project file is built on its own. -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Client Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <CoreDir>$(SolutionDir)StarRupture-ModLoader-Core\</CoreDir>
    <DoublesDir>$(SolutionDir)Tests\VersionMapTests\</DoublesDir>
    <OutDir>$(SolutionDir)build\tests\</OutDir>
    <IntDir>$(SolutionDir)obj\Tests\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>observed_tests</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- MODLOADER_CLIENT_BUILD gates the map lookups under test. 4005: framework.h redefines the two macros below. -->
      <PreprocessorDefinitions>MODLOADER_CLIENT_BUILD;NDEBUG;_CONSOLE;NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4005;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(DoublesDir);$(ProjectDir);$(CoreDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Label="Test">
    <ClInclude Include="$(DoublesDir)test_doubles.h" />
    <ClCompile Include="observed_tests.cpp" />
    <ClCompile Include="$(DoublesDir)test_doubles.cpp" />
  </ItemGroup>
  <ItemGroup Label="Tool source under test">
    <ClCompile Include="..\observed.cpp" />
    <ClCompile Include="..\carry.cpp" />
    <ClCompile Include="..\report_text.cpp" />
  </ItemGroup>
  <ItemGroup Label="Loader sources under test">
    <ClCompile Include="$(CoreDir)memory_scanner\version_map.cpp" />
    <ClCompile Include="$(CoreDir)memory_scanner\scanner.cpp" />
    <ClCompile Include="$(CoreDir)memory_scanner\image_info.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
