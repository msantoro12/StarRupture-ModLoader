<?xml version="1.0" encoding="utf-8"?>
<!--
  AobScan : sr-aobscan, an offline console tool that runs the loader's scan
  pattern preflight against a game executable on disk.

  Not part of the solution, so release.yml is unaffected. Build the
  project file directly:

    msbuild Tools\AobScan\AobScan.vcxproj /p:Configuration="Client Release" /p:Platform=x64
    msbuild Tools\AobScan\AobScan.vcxproj /p:Configuration="Server Release" /p:Platform=x64

  The configuration picks which pattern registry is compiled in, exactly as it
  does for the loader. Output goes to build\tools\sr-aobscan-client.exe and
  build\tools\sr-aobscan-server.exe. It compiles the loader's own scanner,
  scan_validation, image_info and patch_overlay and replaces only what those
  reach out to (see stubs.cpp), so the pattern list can not drift from the one
  the loader scans with.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Client Release|x64">
      <Configuration>Client Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Server Release|x64">
      <Configuration>Server Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{D4F81B36-92C7-4A5E-8B03-6E1A7C95F2D0}</ProjectGuid>
    <RootNamespace>AobScan</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Set by Visual Studio and by building the .sln; empty when this project file is built on its own. -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <CoreDir>$(SolutionDir)StarRupture-ModLoader-Core\</CoreDir>
    <OutDir>$(SolutionDir)build\tools\</OutDir>
    <IntDir>$(SolutionDir)obj\Tools\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Client Release'">
    <TargetName>sr-aobscan-client</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Server Release'">
    <TargetName>sr-aobscan-server</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The live loader headers, on purpose: a scanner built against a stale copy would check nothing. -->
      <AdditionalIncludeDirectories>$(CoreDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Static runtime: the tool runs on a CI runner with nothing installed. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Client Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_CLIENT_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Server Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_SERVER_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Label="Tool">
    <ClCompile Include="aobscan.cpp" />
    <ClCompile Include="stubs.cpp" />
    <ClCompile Include="plugin_scan.cpp" />
    <ClCompile Include="suggest.cpp" />
    <ClCompile Include="layout.cpp" />
  </ItemGroup>
  <ItemGroup Label="Loader sources used as they are">
    <ClCompile Include="$(CoreDir)memory_scanner\scanner.cpp" />
    <ClCompile Include="$(CoreDir)memory_scanner\scan_validation.cpp" />
    <ClCompile Include="$(CoreDir)memory_scanner\image_info.cpp" />
    <ClCompile Include="$(CoreDir)memory_scanner\patch_overlay.cpp" />
    <ClCompile Include="$(CoreDir)memory_scanner\hook_scanner_interface.cpp" />
    <!-- Interface 72 and later: per-build locator selection. -->
    <ClCompile Include="$(CoreDir)memory_scanner\version_map.cpp" Condition="Exists('$(CoreDir)memory_scanner\version_map.cpp')" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
